# ============================================
# CBT Infrastructure Configuration
# ============================================

# Node.js Environment
NODE_ENV=development

# Server Ports
PORT=3000
WS_PORT=8080
MONITORING_PORT=3001

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cbtmo_db
DB_USER=postgres
DB_PASSWORD=postgres

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Application Settings
LOG_LEVEL=info
CACHE_TTL=3600
MAX_CONNECTIONS=20

# Feature Flags
ENABLE_WEBSOCKET=true
ENABLE_REDIS=true
ENABLE_MONITORING=true
ENABLE_COMPRESSION=true
